{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "terravalue-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    // 09:00 UTC — daily archiver.
    // 06:00 UTC daily — enqueue a scrape run. Producer only; the work happens
    // in the queue consumers below, each with its own budget.
    //
    // This was "0 6 */2 * *" during the Railway parallel run, to hold the
    // combined Firecrawl bill near single-runtime cost while both stacks
    // scraped the same ~54 sources. Two traps that cost us coverage, recorded
    // so nobody reintroduces them: a `*/2` day-of-month step fires on ODD days
    // (1,3,5,...), silently skipping every even one; and the run cadence was
    // the only thing standing between us and a full day of missed listings.
    // Railway is gone — this is the only scraper now, so it runs every day.
    //
    // 12:00 UTC on the 4th, 8th and 12th — pull any new Land Talk Monthly
    // newsletter into `land_sales_comps`. Iowa Appraisal posts the previous
    // month early in the month but not on a fixed date, hence three attempts.
    // Runs are idempotent and skip months already held, so the two that find
    // nothing cost one Firecrawl scrape each. This ingest had NO schedule at
    // all until 2026-08-21, and June and July 2026 (113 sales) went missing
    // without any error surfacing — valuations just read stale comps.
    "crons": ["0 9 * * *", "0 6 * * *", "0 12 4,8,12 * *"]
  },
  "queues": {
    "producers": [
      { "binding": "SCRAPE_SOURCES", "queue": "tv-scrape-sources" },
      { "binding": "SCRAPE_DETAILS", "queue": "tv-scrape-details" },
      { "binding": "ENRICH", "queue": "tv-enrich" }
    ],
    "consumers": [
      {
        // One source per message: discovery is a handful of Firecrawl calls.
        // Small batches keep each invocation well inside its subrequest budget.
        "queue": "tv-scrape-sources",
        "max_batch_size": 1,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "max_concurrency": 4,
        "dead_letter_queue": "tv-dlq"
      },
      {
        // One listing per message. Concurrency is capped well below Firecrawl's
        // rate limit — the point is steady throughput, not a thundering herd.
        "queue": "tv-scrape-details",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "max_concurrency": 8,
        "dead_letter_queue": "tv-dlq"
      },
      {
        // Enrichment is OpenAI-bound and slower; keep batches small.
        "queue": "tv-enrich",
        "max_batch_size": 3,
        "max_batch_timeout": 60,
        "max_retries": 2,
        "max_concurrency": 4,
        "dead_letter_queue": "tv-dlq"
      }
    ]
  }
}
