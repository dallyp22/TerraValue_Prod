{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "terravalue-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 9 * * *",
      "*/5 * * * *"
    ]
  }
}
